{
  "name": "pulpit",
  // The Vite+ base image (Node + pnpm + the vp CLI), tagged at the catalog's
  // `vite-plus` pin in pnpm-workspace.yaml (1.4.0). Dependabot's `devcontainers`
  // updates move only the features below, so bump this tag by hand on the
  // toolchain PR that moves `vite-plus`.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.4.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/ripgrep:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainer-community/devcontainer-features/jq:1": {}
  },
  // Provisioning is .claude/hooks/session-start.sh, the same file the Claude
  // Code SessionStart hook runs, so a container shell and an agent session are
  // provisioned identically: the pinned Vite+ CLI, its `vp` / `vpx` links for
  // non-interactive shells, and a frozen-lockfile install (see the file's header).
  "postCreateCommand": "bash .claude/hooks/session-start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["Anthropic.claude-code", "oxc.oxc-vscode"]
    }
  },
  "workspaceFolder": "/workspaces/pulpit"
}
