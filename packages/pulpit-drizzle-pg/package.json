{
  "name": "@thomasfosterau/pulpit-drizzle-pg",
  "version": "0.0.0",
  "private": true,
  "description": "The tree-bound seams of @thomasfosterau/pulpit (the version-chain port, the leaf store and its list filter renderer) over the tables and views @thomasfosterau/effect-drizzle-ext derives from an application's tree, on PostgreSQL.",
  "keywords": [
    "cms",
    "drizzle",
    "drizzle-orm",
    "effect",
    "headless-cms",
    "postgres",
    "postgresql",
    "typescript",
    "versioning"
  ],
  "homepage": "https://github.com/thomasfosterau/pulpit/tree/trunk/packages/pulpit-drizzle-pg#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/pulpit/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/pulpit.git",
    "directory": "packages/pulpit-drizzle-pg"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./documents": "./src/documents.ts",
    "./edges": "./src/edges.ts",
    "./embeddings": "./src/embeddings.ts",
    "./external-ids": "./src/external-ids.ts",
    "./filter": "./src/filter.ts",
    "./leaf-store": "./src/leaf-store.ts",
    "./proposals": "./src/proposals.ts",
    "./publication": "./src/publication.ts",
    "./reactions": "./src/reactions.ts",
    "./paths": "./src/paths.ts",
    "./search": "./src/search.ts",
    "./version-chain": "./src/version-chain.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./documents": {
        "types": "./dist/documents.d.ts",
        "default": "./dist/documents.js"
      },
      "./edges": {
        "types": "./dist/edges.d.ts",
        "default": "./dist/edges.js"
      },
      "./embeddings": {
        "types": "./dist/embeddings.d.ts",
        "default": "./dist/embeddings.js"
      },
      "./external-ids": {
        "types": "./dist/external-ids.d.ts",
        "default": "./dist/external-ids.js"
      },
      "./filter": {
        "types": "./dist/filter.d.ts",
        "default": "./dist/filter.js"
      },
      "./leaf-store": {
        "types": "./dist/leaf-store.d.ts",
        "default": "./dist/leaf-store.js"
      },
      "./proposals": {
        "types": "./dist/proposals.d.ts",
        "default": "./dist/proposals.js"
      },
      "./publication": {
        "types": "./dist/publication.d.ts",
        "default": "./dist/publication.js"
      },
      "./reactions": {
        "types": "./dist/reactions.d.ts",
        "default": "./dist/reactions.js"
      },
      "./paths": {
        "types": "./dist/paths.d.ts",
        "default": "./dist/paths.js"
      },
      "./search": {
        "types": "./dist/search.d.ts",
        "default": "./dist/search.js"
      },
      "./version-chain": {
        "types": "./dist/version-chain.d.ts",
        "default": "./dist/version-chain.js"
      }
    },
    "access": "public"
  },
  "devDependencies": {
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@thomasfosterau/effect-drizzle-ext": "catalog:",
    "@thomasfosterau/effect-drizzle-ext-pg": "catalog:",
    "@thomasfosterau/pulpit": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "tsx": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-drizzle-ext": "catalog:peers",
    "@thomasfosterau/effect-drizzle-ext-pg": "catalog:peers",
    "@thomasfosterau/pulpit": "workspace:^",
    "drizzle-orm": "catalog:peers",
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22.18"
  }
}
