{
  "$schema": "https://www.schemastore.org/package",
  "name": "pulpit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for @thomasfosterau/pulpit, a headless CMS kernel on Effect, and its optional packages.",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "scripts": {
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "release": "pnpm -r --filter './packages/*' publish --access public --no-git-checks --ignore-scripts && changeset git-tag",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "lts"
    }
  },
  "packageManager": "pnpm@11.18.0"
}
