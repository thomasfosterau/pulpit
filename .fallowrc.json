{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/pulpit/src/index.ts",
    "packages/pulpit/src/Content.ts",
    "packages/pulpit/src/Registry.ts",
    "packages/pulpit/src/VersionChain.ts",
    "packages/pulpit/src/Subtype.ts",
    "packages/pulpit/src/Publication.ts",
    "packages/pulpit/src/Cache.ts",
    "packages/pulpit/src/Documents.ts",
    "packages/pulpit/src/Edges.ts",
    "packages/pulpit/src/WorkingCopy.ts",
    "packages/pulpit/src/Comments.ts",
    "packages/pulpit/src/Purge.ts",
    "packages/pulpit/src/Erasure.ts",
    "packages/pulpit/src/Search.ts",
    "packages/pulpit/src/Budgets.ts",
    "packages/pulpit/src/Reactions.ts",
    "packages/pulpit/src/Social.ts",
    "packages/pulpit/src/Audience.ts",
    "packages/pulpit/src/Discovery.ts",
    "packages/pulpit/src/Relations.ts",
    "packages/pulpit/src/Translation.ts",
    "packages/pulpit/src/Notifications.ts",
    "packages/pulpit/src/ReferenceImport.ts",
    "packages/pulpit/src/Blobs.ts",
    "packages/pulpit/src/Paths.ts",
    "packages/pulpit/src/Pages.ts",
    "packages/pulpit/src/Media.ts",
    "packages/pulpit/src/Collections.ts",
    "packages/pulpit/src/Links.ts",
    "packages/pulpit/src/Proposals.ts",
    "packages/pulpit/src/Moderation.ts",
    "packages/pulpit/src/testing.ts",
    "packages/pulpit/tests/**/*.test.ts",
    "packages/pulpit/tests/**/*.types.ts",
    "packages/pulpit-wordpress/src/index.ts",
    "packages/pulpit-wordpress/src/Api.ts",
    "packages/pulpit-wordpress/src/Http.ts",
    "packages/pulpit-wordpress/src/Ids.ts",
    "packages/pulpit-wordpress/src/testing.ts",
    "packages/pulpit-wordpress/tests/**/*.test.ts",
    "packages/pulpit-wordpress/tests/**/*.types.ts",
    "packages/pulpit-drizzle-pg/src/index.ts",
    "packages/pulpit-drizzle-pg/src/VersionChain.ts",
    "packages/pulpit-drizzle-pg/src/LeafStore.ts",
    "packages/pulpit-drizzle-pg/src/Filter.ts",
    "packages/pulpit-drizzle-pg/src/Publication.ts",
    "packages/pulpit-drizzle-pg/src/Paths.ts",
    "packages/pulpit-drizzle-pg/src/Collections.ts",
    "packages/pulpit-drizzle-pg/src/Documents.ts",
    "packages/pulpit-drizzle-pg/src/Search.ts",
    "packages/pulpit-drizzle-pg/src/Edges.ts",
    "packages/pulpit-drizzle-pg/src/Embeddings.ts",
    "packages/pulpit-drizzle-pg/src/ExternalIds.ts",
    "packages/pulpit-drizzle-pg/src/Erasure.ts",
    "packages/pulpit-drizzle-pg/src/Memberships.ts",
    "packages/pulpit-drizzle-pg/src/Proposals.ts",
    "packages/pulpit-drizzle-pg/src/Reactions.ts",
    "packages/pulpit-drizzle-pg/src/Reports.ts",
    "packages/pulpit-drizzle-pg/src/Social.ts",
    "packages/pulpit-drizzle-pg/tests/**/*.test.ts",
    "packages/pulpit-drizzle-pg/tests/**/*.types.ts",
    "packages/pulpit-drizzle-pg/tests/integration/global-setup.ts",
    "packages/pulpit-drizzle-pg/vitest.integration.config.ts",
    "tests/dist-consumer/src/*.ts",
    "**/vite.config.ts"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "packages/pulpit/docs/**",
    "packages/pulpit-wordpress/docs/**",
    "packages/pulpit-drizzle-pg/docs/**"
  ],
  "ignoreDependencies": [
    "@types/node",
    "@effect/docgen",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@vitest/coverage-istanbul",
    "fallow",
    // The two workspace packages, for tests/dist-consumer. That
    // package resolves them only through its tsconfig `paths` mapping to the
    // emitted `dist/*.d.ts`, so until `dist/` is built fallow reports them as
    // unlisted. Declaring them `workspace:*` there would add a `node_modules`
    // link, and tsc falls back to it (and on to `src/`) when a subpath is
    // missing from `dist/`, so the check would pass on an incomplete build.
    // `overrides` and inline suppressions don't apply to this rule, so the
    // ignore is global. Elsewhere it hides nothing the type gate misses: an
    // undeclared import of either package has no `node_modules` link (pnpm
    // hoists no workspace package to the root), so tsc fails with TS2307.
    "@thomasfosterau/pulpit",
    "@thomasfosterau/pulpit-wordpress",
    "@thomasfosterau/pulpit-drizzle-pg"
  ],
  "rulePacks": ["fallow-rules.json"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "pulpit-internal",
        "patterns": ["packages/pulpit/src/internal/**", "packages/pulpit/tests/**"]
      },
      {
        "name": "pulpit",
        "patterns": ["packages/pulpit/**"]
      },
      {
        "name": "pulpit-wordpress",
        "patterns": ["packages/pulpit-wordpress/**"]
      },
      {
        "name": "pulpit-drizzle-pg",
        "patterns": ["packages/pulpit-drizzle-pg/**"]
      },
      {
        "name": "dist-consumer",
        "patterns": ["tests/dist-consumer/**"]
      }
    ],
    "rules": [
      {
        "from": "pulpit-internal",
        "allow": ["pulpit"]
      },
      {
        "from": "pulpit",
        "allow": ["pulpit-internal"]
      },
      {
        "from": "pulpit-wordpress",
        "allow": ["pulpit"]
      },
      {
        "from": "pulpit-drizzle-pg",
        "allow": ["pulpit"]
      },
      {
        "from": "dist-consumer",
        "allow": ["pulpit", "pulpit-wordpress", "pulpit-drizzle-pg"]
      }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
