{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/pulpit/src/index.ts",
    "packages/pulpit/src/content.ts",
    "packages/pulpit/src/registry.ts",
    "packages/pulpit/src/version-chain.ts",
    "packages/pulpit/src/subtype.ts",
    "packages/pulpit/src/publication.ts",
    "packages/pulpit/src/documents.ts",
    "packages/pulpit/src/edges.ts",
    "packages/pulpit/src/working-copy.ts",
    "packages/pulpit/src/comments.ts",
    "packages/pulpit/src/purge.ts",
    "packages/pulpit/src/search.ts",
    "packages/pulpit/src/blobs.ts",
    "packages/pulpit/src/paths.ts",
    "packages/pulpit/src/proposals.ts",
    "packages/pulpit/src/moderation.ts",
    "packages/pulpit/src/testing.ts",
    "packages/pulpit/tests/**/*.test.ts",
    "packages/pulpit/tests/**/*.types.ts",
    "packages/pulpit-wordpress/src/index.ts",
    "packages/pulpit-wordpress/src/api.ts",
    "packages/pulpit-wordpress/src/http.ts",
    "packages/pulpit-wordpress/src/ids.ts",
    "packages/pulpit-wordpress/src/testing.ts",
    "packages/pulpit-wordpress/tests/**/*.test.ts",
    "packages/pulpit-wordpress/tests/**/*.types.ts",
    "tests/dist-consumer/src/*.ts",
    "**/vite.config.ts"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "packages/pulpit/docs/**",
    "packages/pulpit-wordpress/docs/**"
  ],
  "ignoreDependencies": [
    "@types/node",
    "@effect/docgen",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "tsx",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@vitest/coverage-istanbul",
    "fallow",
    // The two workspace packages, for tests/dist-consumer (pulpit#134). That
    // package resolves them only through its tsconfig `paths` mapping to the
    // emitted `dist/*.d.ts`, so until `dist/` is built fallow reports them as
    // unlisted. Declaring them `workspace:*` there would add a `node_modules`
    // link, and tsc falls back to it (and on to `src/`) when a subpath is
    // missing from `dist/`, so the check would pass on an incomplete build.
    // `overrides` and inline suppressions don't apply to this rule, so the
    // ignore is global. Elsewhere it hides nothing the type gate misses: an
    // undeclared import of either package has no `node_modules` link (pnpm
    // hoists no workspace package to the root), so tsc fails with TS2307.
    "@thomasfosterau/pulpit",
    "@thomasfosterau/pulpit-wordpress"
  ],
  "rulePacks": ["fallow-rules.json"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "pulpit-internal",
        "patterns": ["packages/pulpit/src/internal/**", "packages/pulpit/tests/**"]
      },
      {
        "name": "pulpit",
        "patterns": ["packages/pulpit/**"]
      },
      {
        "name": "pulpit-wordpress",
        "patterns": ["packages/pulpit-wordpress/**"]
      },
      {
        "name": "dist-consumer",
        "patterns": ["tests/dist-consumer/**"]
      }
    ],
    "rules": [
      {
        "from": "pulpit-internal",
        "allow": ["pulpit"]
      },
      {
        "from": "pulpit",
        "allow": ["pulpit-internal"]
      },
      {
        "from": "pulpit-wordpress",
        "allow": ["pulpit"]
      },
      {
        "from": "dist-consumer",
        "allow": ["pulpit", "pulpit-wordpress"]
      }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
