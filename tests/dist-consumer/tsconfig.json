{
  // The tsconfig oxlint-tsgolint reads for type-aware lint and `typeCheck`
  // (it types each file with its nearest `tsconfig.json`). It maps the two
  // package names to their `src/`, so `vp check` needs no build first (CI
  // lints before it builds). The declaration-emit gate itself is
  // tsconfig.check.json, which maps them to the EMITTED `dist/` declarations
  // and is what this package's `check` task (`vp run check`) runs.
  "extends": "./tsconfig.check.json",
  "compilerOptions": {
    "paths": {
      "@thomasfosterau/pulpit": ["../../packages/pulpit/src/index.ts"],
      "@thomasfosterau/pulpit/*": ["../../packages/pulpit/src/*.ts"],
      "@thomasfosterau/pulpit-wordpress": ["../../packages/pulpit-wordpress/src/index.ts"],
      "@thomasfosterau/pulpit-wordpress/*": ["../../packages/pulpit-wordpress/src/*.ts"]
    }
  }
}
